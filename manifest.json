{
  "manifest_version": 3,
  "name": "Hostinger Reply Alias Fix",
  "version": "0.4.0",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://mail.hostinger.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Hostinger Reply Alias Fix",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "description": "On Hostinger Webmail, selects the From identity matching the address a message was sent to when you reply or forward, and lets you pick a default From identity for new messages.",
  "content_scripts": [
    {
      "matches": ["https://mail.hostinger.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
